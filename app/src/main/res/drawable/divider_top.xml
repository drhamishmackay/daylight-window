<?xml version="1.0" encoding="utf-8"?>
<!-- A hairline above each row, drawn by insetting a filled rectangle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rule" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/raised" />
        </shape>
    </item>
</layer-list>
